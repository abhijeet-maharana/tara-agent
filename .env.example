# Slack app (Socket Mode). Bot token: xoxb-..., app-level token with connections:write: xapp-...
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: a person's user token (xoxp-..., user scope chat:write). Scheduled-run trigger messages
# are then posted as that person instead of the bot, and so are Approvals-page notes (and decisions
# that start a new chat) in a card's thread.
SLACK_USER_TOKEN=
# Only needed for projects/jobs with "billing": "api"
ANTHROPIC_API_KEY=
