# Slack app (Socket Mode). Bot token: xoxb-..., app-level token with connections:write: xapp-...
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Only needed for projects/jobs with "billing": "api"
ANTHROPIC_API_KEY=
# Live voice (host config `live`): a Google AI Studio API key for Gemini Live
TARA_LIVE_API_KEY=
